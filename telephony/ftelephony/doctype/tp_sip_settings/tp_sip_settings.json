  {
   "fieldname": "local_https_section",
   "fieldtype": "Section Break",
   "label": "Local HTTPS Testing",
   "description": "Optional self-signed HTTPS endpoint for local/LAN browser testing. Production TLS should remain on the normal reverse proxy or edge."
  },
  {
   "default": "0",
   "fieldname": "enable_local_https",
   "fieldtype": "Check",
   "label": "Enable Local HTTPS Testing",
   "description": "Start a Bench-managed self-signed HTTPS endpoint. The browser will show an untrusted certificate warning until you explicitly proceed."
  },
  {
   "depends_on": "enable_local_https",
   "fieldname": "local_https_host",
   "fieldtype": "Data",
   "label": "Testing Host or IP",
   "description": "Hostname or LAN IP users will enter in the browser, for example 192.168.1.222."
  },
  {
   "default": "8443",
   "depends_on": "enable_local_https",
   "fieldname": "local_https_port",
   "fieldtype": "Int",
   "label": "HTTPS Port",
   "description": "Non-privileged port used by the local HTTPS endpoint. Ports below 1024 are intentionally not supported."
  },
  {
   "fieldname": "local_https_status_html",
   "fieldtype": "HTML",
   "label": "Local HTTPS Status"
  },
  {
   "fieldname": "sip_server",
   "fieldtype": "Data",
   "label": "SIP Server",
   "depends_on": "enabled",
   "mandatory_depends_on": "eval:doc.enabled",
   "description": "Native SIP PBX hostname or IP address."
  },
  {
   "fieldname": "sip_port",
   "fieldtype": "Int",
   "label": "SIP Port",
   "default": "5060",
   "depends_on": "enabled",
   "description": "Remote PBX SIP port. This is not a local Telephony bind port."
  },
  {
   "fieldname": "transport",
   "fieldtype": "Select",
   "label": "Transport",
   "options": "UDP\nTCP\nTLS",
   "default": "UDP",
   "depends_on": "enabled"
  },
  {
   "fieldname": "local_bind_address",
   "fieldtype": "Data",
   "label": "Local Bind Address",
   "default": "0.0.0.0",
   "depends_on": "enabled",
   "description": "Local interface/IP only. The OS chooses the local SIP port automatically."
  },
  {
   "fieldname": "advertised_address",
   "fieldtype": "Data",
   "label": "Advertised Address",
   "depends_on": "enabled",
   "description": "Optional address advertised in SIP/SDP when topology requires it."
  },
  {
   "fieldname": "section_native_advanced",
   "fieldtype": "Section Break",
